---
import Layout from '../layouts/Layout.astro';
import Header from '@components/Header';
import Footer from '@components/Footer';
import ReviewsHeroSection from '@components/reviews/ReviewsHeroSection';
import ReviewsArchiveSection from '@components/reviews/ReviewsArchiveSection';
---

<Layout title="Casino Reviews - Truedinkumbet Australia">
  <div class="min-h-screen flex flex-col">
    <Header client:load />
    <main class="flex-1 pt-16">
      <ReviewsHeroSection client:load />
      <ReviewsArchiveSection client:load />
    </main>
    <Footer client:load />
  </div>
</Layout>
