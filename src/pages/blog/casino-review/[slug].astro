---
import Layout from '../../../layouts/Layout.astro';
import Header from '@components/Header';
import Footer from '@components/Footer';
import CasinoReviewArticleContent, {
  articles,
  getArticleSlug,
  isArticleIndexable,
} from '@components/blog/casino-review/CasinoReviewArticleContent';

export function getStaticPaths() {
  const articleSlugs = [...new Set(articles.map(getArticleSlug))];
  return articleSlugs.map((slug) => ({
    params: { slug },
  }));
}

const { slug } = Astro.params;
const article = articles.find((item) => getArticleSlug(item) === slug);

if (!article) {
  throw new Error(`Missing article data for slug: ${slug}`);
}

const cleanDescription = article.description
  .replace(/\s*\[\.\.\.\]\s*$/, '')
  .replace(/\s+/g, ' ')
  .trim();
const metaDescription = cleanDescription.length > 158
  ? `${cleanDescription.slice(0, 155).replace(/\s+\S*$/, '')}...`
  : cleanDescription;
const titleSuffix = ' | Truedinkumbet';
const metaTitle = article.title.length + titleSuffix.length <= 65
  ? `${article.title}${titleSuffix}`
  : article.title.length <= 65
    ? article.title
    : `${article.title.slice(0, 62).replace(/\s+\S*$/, '')}...`;
---

<Layout
  title={metaTitle}
  description={metaDescription}
  image={article.image}
  type="article"
  indexable={isArticleIndexable(article)}
>
  <div class="min-h-screen flex flex-col">
    <Header client:load />
    <main class="flex-1 pt-16">
      <CasinoReviewArticleContent client:load slug={slug!} />
    </main>
    <Footer client:load />
  </div>
</Layout>
